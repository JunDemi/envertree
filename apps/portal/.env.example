# 이 파일을 .env.local 로 복사해서 값을 채운다. (.env.local은 git에 올라가지 않음)

# 사이트 공개 주소 (선택). 비워두면 Vercel 프로덕션 도메인 또는 localhost를 사용.
# OG 이미지 등 절대 URL 생성에 쓰인다.
NEXT_PUBLIC_SITE_URL=

# Supabase 대시보드 → Project Settings → API Keys 에서 확인
# URL은 "https://<project-ref>.supabase.co" 까지만 (끝에 /rest/v1 등을 붙이지 않음)
# 비워두면 로그인 기능만 꺼지고 사이트는 동작한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
